# ─────────────────────────────────────────────────────────────────────────────
# Muthaker API — environment variables.
# Copy to `.env` for local development. PLACEHOLDERS ONLY, never commit real values.
# Staging/production values live in Vercel env vars and GitHub Secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime: development | test | production
NODE_ENV=development
# Port for the long-running local server (Vercel ignores it)
PORT=4000
# Optional: pino log level (fatal|error|warn|info|debug|trace)
LOG_LEVEL=debug

# ── Database ──
# Runtime connection. Local: Docker Postgres. Prod: Supabase TRANSACTION pooler (port 6543)
# e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://muthaker:muthaker@localhost:5432/muthaker
# Migrations only. Direct connection or SESSION pooler (port 5432). Never the transaction pooler.
DIRECT_URL=postgresql://muthaker:muthaker@localhost:5432/muthaker

# ── Web / CORS ──
# Comma-separated allowlist of browser origins (CORS, credentials: true)
WEB_ORIGIN=http://localhost:3000
# Public URL of the web app (used in emails and OAuth redirects)
WEB_APP_URL=http://localhost:3000

# ── Auth (JWT + cookies) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# true in staging/production (HTTPS). false locally.
COOKIE_SECURE=false

# ── Google sign-in (OAuth 2.0 / OIDC) ──
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must be on the WEB origin (proxied to the API by the Next.js rewrite) so cookies stay first-party
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# ── Storage (S3 API). Local: MinIO. Prod: Supabase Storage S3 endpoint ──
# Supabase: https://<project_ref>.storage.supabase.co/storage/v1/s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Public-read bucket (avatars) and private bucket (attachments, presigned only)
S3_BUCKET_PUBLIC=avatars
S3_BUCKET_PRIVATE=attachments
# Optional: base URL for public objects. Defaults to <S3_ENDPOINT>/<bucket>.
# Supabase: https://<project_ref>.supabase.co/storage/v1/object/public
S3_PUBLIC_BASE_URL=

# ── Mail (SMTP via Nodemailer). Local: Mailpit. Prod: Gmail SMTP + App Password ──
SMTP_HOST=localhost
SMTP_PORT=1025
# true for port 465 (implicit TLS); false for 587 (STARTTLS) or Mailpit
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Muthaker <no-reply@muthaker.local>"

# ── Rate limiting ──
# Local: redis://localhost:6379. Prod: Upstash (rediss://...). Empty = in-memory fallback.
REDIS_URL=redis://localhost:6379

# ── Cron ──
# Bearer secret for /api/v1/internal/cron/* (called by cron-job.org). Long random string.
CRON_SECRET=change-me-cron-secret-at-least-32-characters

# ── Seed (admin account, created by `npm run db:seed`) ──
SEED_ADMIN_EMAIL=admin@muthaker.local
SEED_ADMIN_PASSWORD=ChangeMe-Admin-123!
